ectLiteral","replacement":"{}","statusReason":"expected undefined to be false // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":6.787000000000262,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":103,"line":62},"start":{"column":12,"line":62}}},{"id":"89","mutatorName":"BooleanLiteral","replacement":"true","statusReason":"expected true to be false // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":8.766299999999319,"killedBy":["6"],"coveredBy":["6"],"location":{"end":{"column":28,"line":62},"start":{"column":23,"line":62}}},{"id":"90","mutatorName":"StringLiteral","replacement":"\"\"","status":"Survived","static":false,"testsCompleted":1,"duration":2.7252000000007683,"coveredBy":["6"],"location":{"end":{"column":101,"line":62},"start":{"column":38,"line":62}}},{"id":"91","mutatorName":"ObjectLiteral","replacement":"{}","statusReason":"expected undefined to be true // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":6.998199999998178,"killedBy":["4"],"coveredBy":["4"],"location":{"end":{"column":27,"line":65},"start":{"column":10,"line":65}}},{"id":"92","mutatorName":"BooleanLiteral","replacement":"false","statusReason":"expected false to be true // Object.is equality","status":"Killed","static":false,"testsCompleted":1,"duration":8.619299999998475,"killedBy":["4"],"coveredBy":["4"],"location":{"end":{"column":25,"line":65},"start":{"column":21,"line":65}}}],"source":"export type ExhibitState = 'draft' | 'validated' | 'published';\r\n\r\nexport interface ExhibitWorkflowRecord {\r\n  exhibitName: string;\r\n  categoryId: string | null;\r\n  year: number | null;\r\n  collectiblePrice: number | null;\r\n  validated: boolean;\r\n  published: boolean;\r\n}\r\n\r\nexport interface ExhibitStateTransition {\r\n  exhibitName: string;\r\n  categoryId: string | null;\r\n  current: ExhibitWorkflowRecord;\r\n  nextValidated: boolean;\r\n  nextPublished: boolean;\r\n}\r\n\r\nexport function isAcquisitionYearAllowed(year: number | null): boolean {\r\n  return year === null || (Number.isInteger(year) && year >= 1800 && year <= 2100);\r\n}\r\n\r\nexport function isCollectiblePriceAllowed(price: number | null): boolean {\r\n  return price === null || (Number.isFinite(price) && price >= 0);\r\n}\r\n\r\nexport function getExhibitState(record: Pick<ExhibitWorkflowRecord, 'validated' | 'published'>): ExhibitState {\r\n  if (record.published) return 'published';\r\n  if (record.validated) return 'validated';\r\n  return 'draft';\r\n}\r\n\r\nexport function isPublishAllowed(record: Pick<ExhibitWorkflowRecord, 'exhibitName' | 'categoryId' | 'validated'>): boolean {\r\n  return record.validated && record.exhibitName.trim().length > 0 && record.categoryId !== null;\r\n}\r\n\r\nexport function validateExhibitTransition(input: ExhibitStateTransition): { allowed: true } | { allowed: false; reason: string } {\r\n  if (input.exhibitName.trim().length === 0) {\r\n    return { allowed: false, reason: 'Exhibit name is required' };\r\n  }\r\n  if (input.categoryId === null) {\r\n    return { allowed: false, reason: 'A category is required' };\r\n  }\r\n\r\n  const current = getExhibitState(input.current);\r\n  const next: ExhibitState = input.nextPublished\r\n    ? 'published'\r\n    : input.nextValidated\r\n      ? 'validated'\r\n      : 'draft';\r\n\r\n  if (next === 'published' && !isPublishAllowed({\r\n    exhibitName: input.exhibitName,\r\n    categoryId: input.categoryId,\r\n    validated: input.nextValidated,\r\n  })) {\r\n    return { allowed: false, reason: 'An exhibit must be validated before it can be published' };\r\n  }\r\n\r\n  if (current === 'published' && next !== 'published') {\r\n    return { allowed: false, reason: 'A published exhibit cannot return to draft or validated state' };\r\n  }\r\n\r\n  return { allowed: true };\r\n}\r\n"}},"schemaVersion":"1.0","thresholds":{"high":90,"low":80,"break":80},"testFiles":{"apps/api/test/team/exhibit-workflow.test.ts":{"tests":[{"id":"0","name":"exhibit workflow business rules accepts acquisition years at and between the boundaries","location":{"start":{"column":3,"line":24}}},{"id":"1","name":"exhibit workflow business rules rejects negative or non-finite collectible prices","location":{"start":{"column":3,"line":33}}},{"id":"2","name":"exhibit workflow business rules maps draft, validated, and published states","location":{"start":{"column":3,"line":40}}},{"id":"3","name":"exhibit workflow business rules requires validation, name, and category before publish","location":{"start":{"column":3,"line":46}}},{"id":"4","name":"exhibit workflow business rules allows a draft to become validated and then published","location":{"start":{"column":3,"line":53}}},{"id":"5","name":"exhibit workflow business rules rejects publishing an unvalidated exhibit","location":{"start":{"column":3,"line":71}}},{"id":"6","name":"exhibit workflow business rules rejects every transition out of published","location":{"start":{"column":3,"line":82}}}],"source":"import { describe, expect, it } from 'vitest';\r\nimport {\r\n  getExhibitState,\r\n  isPublishAllowed,\r\n  validateExhibitTransition,\r\n  isAcquisitionYearAllowed,\r\n  isCollectiblePriceAllowed,\r\n  type ExhibitWorkflowRecord,\r\n} from '../../src/exhibits/exhibit-workflow';\r\n\r\nfunction record(overrides: Partial<ExhibitWorkflowRecord> = {}): ExhibitWorkflowRecord {\r\n  return {\r\n    exhibitName: 'Test Exhibit',\r\n    categoryId: '10000000-0000-4000-8000-000000000001',\r\n    year: 2000,\r\n    collectiblePrice: 25,\r\n    validated: false,\r\n    published: false,\r\n    ...overrides,\r\n  };\r\n}\r\n\r\ndescribe('exhibit workflow business rules', () => {\r\n  it('accepts acquisition years at and between the boundaries', () => {\r\n    expect(isAcquisitionYearAllowed(null)).toBe(true);\r\n    expect(isAcquisitionYearAllowed(1800)).toBe(true);\r\n    expect(isAcquisitionYearAllowed(2100)).toBe(true);\r\n    expect(isAcquisitionYearAllowed(1799)).toBe(false);\r\n    expect(isAcquisitionYearAllowed(2101)).toBe(false);\r\n    expect(isAcquisitionYearAllowed(2000.5)).toBe(false);\r\n  });\r\n\r\n  it('rejects negative or non-finite collectible prices', () => {\r\n    expect(isCollectiblePriceAllowed(null)).toBe(true);\r\n    expect(isCollectiblePriceAllowed(0)).toBe(true);\r\n    expect(isCollectiblePriceAllowed(125.5)).toBe(true);\r\n    expect(isCollectiblePriceAllowed(-0.01)).toBe(false);\r\n    expect(isCollectiblePriceAllowed(Number.POSITIVE_INFINITY)).toBe(false);\r\n  });\r\n  it('maps draft, validated, and published states', () => {\r\n    expect(getExhibitState(record())).toBe('draft');\r\n    expect(getExhibitState(record({ validated: true }))).toBe('validated');\r\n    expect(getExhibitState(record({ validated: true, published: true }))).toBe('published');\r\n  });\r\n\r\n  it('requires validation, name, and category before publish', () => {\r\n    expect(isPublishAllowed({ exhibitName: 'Test', categoryId: record().categoryId, validated: true })).toBe(true);\r\n    expect(isPublishAllowed({ exhibitName: 'Test', categoryId: record().categoryId, validated: false })).toBe(false);\r\n    expect(isPublishAllowed({ exhibitName: ' ', categoryId: record().categoryId, validated: true })).toBe(false);\r\n    expect(isPublishAllowed({ exhibitName: 'Test', categoryId: null, validated: true })).toBe(false);\r\n  });\r\n\r\n  it('allows a draft to become validated and then published', () => {\r\n    const draft = record();\r\n    expect(validateExhibitTransition({\r\n      exhibitName: draft.exhibitName,\r\n      categoryId: draft.categoryId,\r\n      current: draft,\r\n      nextValidated: true,\r\n      nextPublished: false,\r\n    }).allowed).toBe(true);\r\n    expect(validateExhibitTransition({\r\n      exhibitName: draft.exhibitName,\r\n      categoryId: draft.categoryId,\r\n      current: record({ validated: true }),\r\n      nextValidated: true,\r\n      nextPublished: true,\r\n    }).allowed).toBe(true);\r\n  });\r\n\r\n  it('rejects publishing an unvalidated exhibit', () => {\r\n    const result = validateExhibitTransition({\r\n      exhibitName: 'Test',\r\n      categoryId: record().categoryId,\r\n      current: record(),\r\n      nextValidated: false,\r\n      nextPublished: true,\r\n    });\r\n    expect(result.allowed).toBe(false);\r\n  });\r\n\r\n  it('rejects every transition out of published', () => {\r\n    const published = record({ validated: true, published: true });\r\n    expect(validateExhibitTransition({\r\n      exhibitName: published.exhibitName,\r\n      categoryId: published.categoryId,\r\n      current: published,\r\n      nextValidated: true,\r\n      nextPublished: false,\r\n    }).allowed).toBe(false);\r\n  });\r\n});\r\n"}},"projectRoot":"C:\\Users\\aliak\\OneDrive\\Desktop\\Assignments\\SQE Project\\MuseumOS","config":{"$schema":"./node_modules/@stryker-mutator/core/schema/stryker-schema.json","testRunner":"vitest","plugins":["@stryker-mutator/vitest-runner"],"vitest":{"configFile":"apps/api/vitest.config.ts","dir":"apps/api","related":true,"pool":"threads"},"mutate":["apps/api/src/exhibits/exhibit-workflow.ts"],"reporters":["clear-text","progress","html","json"],"coverageAnalysis":"perTest","concurrency":2,"thresholds":{"high":90,"low":80,"break":80},"timeoutMS":10000,"allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incremental":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLogLevel":"off","inPlace":false,"logLevel":"info","maxConcurrentTestRu
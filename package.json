{
  "name": "museumos",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @museumos/api dev & pnpm --filter @museumos/web dev",
    "dev:api": "pnpm --filter @museumos/api dev",
    "dev:web": "pnpm --filter @museumos/web dev",
    "dev:pwa": "pnpm --filter @museumos/pwa dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:team": "pnpm --filter @museumos/api exec vitest run test/team",
    "test:coverage:all": "pnpm --filter @museumos/api exec vitest run test/team --coverage --coverage.include=src/exhibits/exhibit-workflow.ts --coverage.include=src/auth/guards/permission.guard.ts --coverage.include=src/exhibits/exhibits.controller.ts --coverage.include=src/exhibits/exhibits.service.ts --coverage.thresholds.statements=0 --coverage.thresholds.branches=100 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0",
    "test:api": "pnpm test:data && node scripts/team/api-e2e.mjs",
    "test:recovery:db": "pnpm --filter @museumos/api exec tsx test/team/exhibit-recovery.integration.ts",
    "test:recovery:outage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/team/run-db-outage-recovery.ps1",
    "test:reset:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/team/reset-sqe-test-db.ps1",
    "test:e2e": "playwright test",
    "test:data": "node scripts/team/generate-api-cases.mjs docs/team/planning/openapi.yaml docs/team/evidence/api/api-generated-cases.json",
    "test:data:constraints": "pnpm test:data && node scripts/team/check-generator-constraints.mjs",
    "test:mutation": "stryker run",
    "test:mutation:custom": "node scripts/team/custom-mutators.mjs",
    "report:charts": "python -B docs/team/generators/generate-charts.py",
    "report:pdf": "python -B docs/team/generators/generate-report.py",
    "package:zip": "python -B scripts/team/create-submission-zip.py",
    "db:generate": "pnpm --filter @museumos/db generate",
    "db:migrate": "pnpm --filter @museumos/db migrate",
    "db:seed": "pnpm --filter @museumos/db seed",
    "db:studio": "pnpm --filter @museumos/db studio",
    "docker:dev": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf node_modules dist .turbo && rm -rf node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "body-parser": ">=2.4.0",
      "qs": ">=6.16.1",
      "react-router": "^7.18.2",
      "react-router-dom": "^7.18.2",
      "multer": ">=2.5.0",
      "source-map-js": ">=1.2.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "pg": "^8.20.0",
    "sharp": "^0.34.5"
  }
}
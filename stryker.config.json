{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "apps/api/vitest.config.ts",
    "dir": "apps/api",
    "related": true
  },
  "mutate": [
    "apps/api/src/exhibits/exhibit-workflow.ts",
    "apps/api/src/auth/guards/permission.guard.ts",
    "apps/api/src/exhibits/exhibits.controller.ts:183-310"
  ],
  "disableTypeChecks": "apps/api/**/*.ts",
  "reporters": ["clear-text", "progress", "html", "json"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "timeoutMS": 10000
}
